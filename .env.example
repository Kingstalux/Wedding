# Copy this file to .env.local and fill in the values from
# Supabase dashboard → Project Settings → API.
# .env.local is ignored by git, so your keys never reach GitHub.
#
# Only VITE_* variables are exposed to the browser. The anon key is safe
# to expose: Row Level Security decides what it can read.
# NEVER put the service_role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
